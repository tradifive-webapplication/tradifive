


              {/* Header */}
              <div style={{ padding: "28px 24px 20px", display: "flex", justifyContent: "space-between", alignItems: "center", flexShrink: 0 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                  <img src="/favicon.png" style={{ height: 28, width: "auto" }} alt="Icon" />
                  <img src="/Dark mode logo with white.png" style={{ height: 22, width: "auto" }} alt="TradiFive" />
                </div>
                <motion.button
                  whileTap={{ scale: 0.9 }}
                  onClick={() => setMobileMenuOpen(false)}
                  style={{
                    background: "rgba(255,255,255,0.06)",
                    border: "1px solid rgba(255,255,255,0.10)",
                    borderRadius: "50%", width: 36, height: 36,
                    display: "flex", alignItems: "center", justifyContent: "center",
                    color: "rgba(255,255,255,0.7)", cursor: "pointer",
                  }}
                >
                  <X size={16} />
                </motion.button>
              </div>

              {/* Scrollable Content */}
              <div style={{ flex: 1, overflowY: "auto", padding: "0 20px 24px", display: "flex", flexDirection: "column", gap: 8 }}>

                {/* ── TradiFive AI Hero Card ── */}
                <motion.div
                  initial={{ opacity: 0, y: 16 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.06, duration: 0.4, ease: [0.16,1,0.3,1] }}
                >
                  <button
                    onClick={() => { setMobileMenuOpen(false); navigate("/features/tradifive-ai"); }}
                    style={{
                      width: "100%", textAlign: "left",
                      background: "linear-gradient(135deg, rgba(168,85,247,0.14) 0%, rgba(99,102,241,0.08) 100%)",
                      border: "1px solid rgba(168,85,247,0.25)",
                      borderRadius: 18, padding: "18px 20px",
                      cursor: "pointer", marginBottom: 4,
                      position: "relative", overflow: "hidden",
                    }}
                  >
                    <div style={{ position: "absolute", top: -20, right: -20, width: 80, height: 80, background: "radial-gradient(circle, rgba(168,85,247,0.2) 0%, transparent 70%)", pointerEvents: "none" }} />
                    <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 8 }}>
                      <div style={{ width: 32, height: 32, borderRadius: 10, background: "rgba(168,85,247,0.18)", border: "1px solid rgba(168,85,247,0.3)", display: "flex", alignItems: "center", justifyContent: "center" }}>
                        <Sparkles size={15} color="#c084fc" />
                      </div>
                      <div>
                        <div style={{ fontSize: 15, fontWeight: 700, color: "#fff", fontFamily: "'Outfit', sans-serif", lineHeight: 1 }}>TradiFive AI</div>
                        <div style={{ fontSize: 10, color: "rgba(192,132,252,0.8)", fontWeight: 600, letterSpacing: "0.08em", textTransform: "uppercase", marginTop: 2 }}>AI Coach</div>
                      </div>
                      <ChevronRight size={16} color="rgba(168,85,247,0.6)" style={{ marginLeft: "auto" }} />
                    </div>
                    <p style={{ fontSize: 12.5, color: "rgba(255,255,255,0.5)", margin: 0, lineHeight: 1.5, fontFamily: "'Inter', sans-serif" }}>
                      Real-time behavioral coaching that knows your trading style.
                    </p>
                  </button>
                </motion.div>


                <motion.div
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ delay: 0.40 }}
                  style={{ paddingLeft: 4, paddingBottom: 2 }}
                >
                  <span style={{ fontSize: 10, fontWeight: 700, color: "rgba(255,255,255,0.28)", letterSpacing: "0.14em", textTransform: "uppercase" }}>
                    General
                  </span>
                </motion.div>

                {/* ── General links ── */}
                {[
                  { label: "Pricing", path: "/#pricing", scrollId: "pricing", emoji: "💎" },
                  { label: "Download App", path: "/download", emoji: "📲" },
                  { label: "Contact Us", path: "/contact", emoji: "✉️" },
                ].map((item, i) => (
                  <motion.div
                    key={item.label}
                    initial={{ opacity: 0, x: 20 }}
                    animate={{ opacity: 1, x: 0 }}
                    transition={{ delay: 0.42 + i * 0.04, duration: 0.32, ease: [0.16,1,0.3,1] }}
                  >
                    {item.scrollId ? (
                      <a
                        href={item.path}
                        onClick={(e) => handleScrollTo(e as any, item.scrollId!)}
                        style={{
                          display: "flex", alignItems: "center", gap: 14,
                          padding: "12px 16px", borderRadius: 12,
                          textDecoration: "none",
                        }}
                      >
                        <span style={{ fontSize: 17, lineHeight: 1 }}>{item.emoji}</span>
                        <span style={{ fontSize: 14.5, fontWeight: 500, color: "rgba(255,255,255,0.65)" }}>{item.label}</span>
                      </a>
                    ) : (
                      <Link
                        to={item.path}
                        onClick={() => setMobileMenuOpen(false)}
                        style={{
                          display: "flex", alignItems: "center", gap: 14,
                          padding: "12px 16px", borderRadius: 12,
                          textDecoration: "none",
                        }}
                      >
                        <span style={{ fontSize: 17, lineHeight: 1 }}>{item.emoji}</span>
                        <span style={{ fontSize: 14.5, fontWeight: 500, color: "rgba(255,255,255,0.65)" }}>{item.label}</span>
                      </Link>
                    )}
                  </motion.div>
                ))}
              </div>

              {/* ── CTA Buttons ── */}
              <motion.div
                initial={{ opacity: 0, y: 16 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.3, duration: 0.45, ease: [0.16,1,0.3,1] }}
                style={{
                  padding: "16px 20px 32px",
                  borderTop: "1px solid rgba(255,255,255,0.06)",
                  display: "flex", flexDirection: "column", gap: 10,
                  flexShrink: 0,
                }}
              >
                <motion.button
                  whileTap={{ scale: 0.97 }}
                  onClick={() => { setMobileMenuOpen(false); handleSignIn(); }}
                  style={{
                    background: "rgba(255,255,255,0.06)",
                    border: "1px solid rgba(255,255,255,0.10)",
                    color: "rgba(255,255,255,0.85)",
                    padding: "14px", borderRadius: 100,
                    fontSize: 15, fontWeight: 600, width: "100%",
                    cursor: "pointer", transition: "all 0.2s",
                    fontFamily: "'Outfit', sans-serif",
                  }}
                >
                  Sign In
                </motion.button>
                <motion.button
                  whileTap={{ scale: 0.97 }}
                  onClick={() => { setMobileMenuOpen(false); handleSignUp(); }}
                  style={{
                    background: "linear-gradient(135deg, #6366f1 0%, #4f46e5 50%, #7c3aed 100%)",
                    border: "none",
                    color: "#fff",
                    padding: "15px", borderRadius: 100,
                    fontSize: 15, fontWeight: 700, width: "100%",
                    cursor: "pointer",
                    fontFamily: "'Outfit', sans-serif",
                    boxShadow: "0 4px 20px rgba(99,102,241,0.35), inset 0 1px 0 rgba(255,255,255,0.15)",
                    display: "flex", alignItems: "center", justifyContent: "center", gap: 8,
                  }}
                >
                  Get Started Free <ArrowRight size={16} />
                </motion.button>
              </motion.div>
            </motion.div>
          </>
        )}
      </AnimatePresence>
    </>
  );
}
