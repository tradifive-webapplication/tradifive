{
  "expo": {
    "name": "Tradifive",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nikil5.tradifive",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tradifive",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tradifive-login-logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0B1020",
          "dark": {
            "backgroundColor": "#05070B"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://hcgylvdvlandtiuudefu.supabase.co",
      "supabaseAnonKey": "sb_publishable_8x-bgvCQJNkpA5z-PohZFg_WvRMAz7A",
      "router": {},
      "eas": {
        "projectId": "00e0a449-ddea-4b1b-b752-76d2042e2f47"
      }
    },
    "owner": "nikil5",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/00e0a449-ddea-4b1b-b752-76d2042e2f47"
    }
  }
}
